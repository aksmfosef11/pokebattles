# Copy to .env for docker compose.

# PostgreSQL started by docker compose (the `db` service). Change the password for any real deployment:
# the server's DATABASE_URL is built from these three, so keep the password to letters and digits.
POSTGRES_USER=pokebattles
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pokebattles
# Connections the server keeps open to PostgreSQL.
PG_POOL_MAX=10

# Enables GET /api/admin/stats (balance statistics) for "Authorization: Bearer <ADMIN_TOKEN>". Empty = off.
ADMIN_TOKEN=

# New accounts per client address per hour (0 = no limit).
REGISTER_PER_HOUR=10

# Host ports.
CLIENT_PORT=8080
SERVER_PORT=8787

# Only when the pages are hosted on another site than the API:
# VITE_API_URL is the API address baked into the client build, CORS_ORIGIN the page origins the server accepts.
VITE_API_URL=
CORS_ORIGIN=
